# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- HTTP ---
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Behind a reverse proxy (nginx/IIS/ALB) set the hop count (1) or the proxy IP/CIDR list.
# Never "true" — that would let clients spoof their IP via X-Forwarded-For.
TRUST_PROXY=false
# Send HSTS (only meaningful when the public URL is HTTPS).
HSTS=false

# --- Sites allowed to submit consent: siteKey=origin[,origin];siteKey2=origin ---
SITES=rjh=https://www.rajthanee.com,https://rajthanee.com;demo=http://localhost:8080
ENABLE_DEMO=true

# --- Abuse protection / privacy ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# >= 32 chars random. Used to HMAC client IPs; rotating it breaks correlation with older rows.
IP_HASH_SECRET=

# --- SQL Server 2016+ (API login: INSERT/SELECT on dbo.ConsentRecord only) ---
DB_SERVER=mssql
DB_PORT=1433
DB_NAME=ConsentDB
DB_USER=consent_app
DB_PASSWORD=
DB_ENCRYPT=true
# true only for dev/self-signed certs; in production install a trusted cert on SQL Server.
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10

# --- Migrations (privileged login, used only by the `migrate` service) ---
MIGRATE_DB_USER=sa
MIGRATE_DB_PASSWORD=
# Dev conveniences:
MIGRATE_CREATE_DB=true
MIGRATE_COMPAT_LEVEL=130
MIGRATE_APP_LOGIN=true

# --- Dev SQL Server container (docker compose --profile dev) ---
MSSQL_SA_PASSWORD=
